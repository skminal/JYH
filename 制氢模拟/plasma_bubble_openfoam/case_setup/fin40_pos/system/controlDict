FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

application     plasmaInterFoam;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         0.06;
deltaT          1e-7;
writeControl    adjustableRunTime;
writeInterval   0.0005;
purgeWrite      0;
writeFormat     ascii;
writePrecision  7;
writeCompression off;
timeFormat      general;
timePrecision   8;
runTimeModifiable yes;
adjustTimeStep  yes;
maxCo           0.4;
maxAlphaCo      0.4;
maxDeltaT       2e-5;
