FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      alpha.ethanol;
}

dimensions [0 0 0 0 0 0 0];
internalField uniform 1;
boundaryField
{
    inlet     { type fixedValue; value uniform 0; }
    capillary { type constantAlphaContactAngle; theta0 45; limit gradient; value uniform 1; }
    bottom    { type zeroGradient; }
    outer     { type zeroGradient; }
    top       { type inletOutlet; inletValue uniform 1; value uniform 1; }

    front { type wedge; }
    back  { type wedge; }
    axis  { type empty; }
}
